---
import {Header} from '@/components/sections/layout/Header';
import Footer from '@/components/sections/layout/Footer.astro';
import "../styles/global.css";
const { title = "Joyería Siesquén" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale = 1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="author" content="Alvaro Siesquén">
		<meta name="keywords" content="joyeria, oro">
	</head>
	<body class="bg-pearl-1 font-heading">
		<Header client:load/>
		<div class="main-container p-20">
			<slot/>
		</div>
		<Footer />
	</body>
</html>

<style scoped>
@media screen and (max-width:1000px) {
	.main-container {
		padding-left: 3rem;
		padding-right: 3rem;
	}
}

@media screen and (max-width:800px) {
	.main-container {
		padding-left: 10px;
		padding-right: 10px;
	}
}
</style>