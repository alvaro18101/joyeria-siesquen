---
import Layout from "@/layouts/Layout.astro";
import FullProductCard from "@/components/cards/FullProductCard.astro";
import ProductCard2 from "@/components/cards/ProductCard2.astro";
import categories from "../../data/categories.json";
import products from "../../data/products.json";

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category }
  }));
}

const { category } = Astro.props;

// Filtrar productos que coincidan con la categoría
const filteredProducts = products.filter(
  (product) => product.category === category.name
);
---

<Layout>
<h1 class="text-3xl font-bold mb-6">{category.name}</h1>

{filteredProducts.length === 0 ? (
  <p>No hay productos en esta categoría.</p>
) : (
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    {filteredProducts.map((product) => (
      <ProductCard2 
        id={product.id}
      />
    ))}
  </div>
)}
</Layout>