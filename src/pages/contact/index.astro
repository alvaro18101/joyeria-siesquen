---
import Layout from "@/layouts/Layout.astro";
import ContactCard from "@/components/cards/ContactCard.astro";
---

<Layout>
    <h1 class="text-4xl md:text-5xl font-bold mb-6 text-center">Ponte en Contacto</h1>
	<p class="mb-10 w-full md:w-3/5 text-light-gray m-auto text-center">Estamos aquí para ayudarte. Contáctanos con cualquier pregunta sobre nuestras colecciones o servicios de joyería.</p>
    <div class="flex flex-col gap-4 lg:flex-row lg:gap-8 mb-10">
        <ContactCard 
            name = "Email"
            description = "Responderemos en 24 horas"
            info = "ha_siesca@hotmail.com"
            icon_name="mail"
        />
        <ContactCard 
            name = "Teléfono"
            description = "Llamadas de lunes a domingo"
            info = "+51 980652426"
            icon_name="phone"
        />
        <ContactCard 
            name = "WhatsApp"
            description = "Respondemos al instante"
            info = "+51 980652426"
            icon_name="smartphone"
        />
    </div>
    <div 
        class="m-auto w-full lg:w-1/2 flex flex-col md:flex-row gap-4 lg:gap-25 justify-center items-center"
    >
        <a href="/catalog" class="w-full text-center px-4 py-3 rounded-lg border border-gold-1 bg-gold-1">Explorar catálogo</a>
        <a 
            href="https://api.whatsapp.com/send?phone=51980652429&text=Hola%2C%20quiero%20info%20sobre%20las%20joyas!"
            target="_blank"
            class="w-full text-center px-4 py-3 rounded-lg border border-gold-1"
        >
            Ir al WhatsApp
        </a>
    </div>
</Layout>

