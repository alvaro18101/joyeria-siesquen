---
import FeaturedCollectionCard from "@/components/cards/FeaturedCollectionCard.astro"
---

<section id="featured-collection">
    <div class="mb-10 md:mb-20">
        <h3 class="text-4xl font-bold mb-4 text-center">Colección Destacada</h3>
        <p class="text-center mb-8 text-light-gray">Nuestras piezas más icónicas y solicitadas</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-8">
            <div class="w-full">
                <FeaturedCollectionCard 
                    category = "Anillos"
                    name = "Anillo de plata con relieve"
                    price = 230.00
                    image_url = "/products/1.jpeg"
                    url = 'products/4'
                />
            </div>
            <div class="w-full ">
                <FeaturedCollectionCard 
                    category = "Aretes"
                    name = "Aretes de plata"
                    price = 155.00
                    image_url = "/products/2.jpeg"
                    url = 'products/4'
                />
            </div>
            <div class="w-full">
                <FeaturedCollectionCard 
                    category = "Anillos"
                    name = "Dige de Virgen de Motupe"
                    price = 75.00
                    image_url = "/products/3.jpeg"
                    url = 'products/4'
                />
            </div>
        </div>
    </div>
</section>