        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="our-categories-card w-full">
                <MoreCollectionsCard 
                    name = "Colección Moderna"
                    description = "Diseños exclusivos para el día más especial de tu vida. Anillos de compromiso y juegos de boda elegantes."
                    detail = "20 productos"
                    image_url = "/products/1.jpeg"
                    url = 'http://lamicenterperu.com/'
                />
            </div>
            <div class="our-categories-card w-full">
                <MoreCollectionsCard 
                    name = "Colección Oro Rosa"
                    description = "Diseños exclusivos para el día más especial de tu vida. Anillos de compromiso y juegos de boda elegantes."
                    detail = "24 productos"
                    image_url = "/products/2.jpeg"
                    url = 'http://lamicenterperu.com/'
                />
            </div>
            <div class="our-categories-card w-full">
                <MoreCollectionsCard 
                    name = "Colección Esmeralda"
                    description = "Diseños exclusivos para el día más especial de tu vida. Anillos de compromiso y juegos de boda elegantes."
                    detail = "24 productos"
                    image_url = "/products/3.jpeg"
                    url = 'http://lamicenterperu.com/'
