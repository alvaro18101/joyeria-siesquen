---
import products from '@/data/products.json';

interface Props {
    id: number;
}

const {id} = Astro.props;

const product = products.find(p => (p.id == id))
---

<div class="product-container">
    <div class="product-image">
        <img
            class="rounded-2xl w-full mb-2" 
            src={product?.image} 
            alt="" 
            draggable="false"
        >
    </div>
    <div class="product-text font-bold">
        <p class="text-gold-1 text-sm">{product?.category}</p>
        <h3 class="text-xl">
            <a href={`/products/${product?.id}`}>
                {product?.name}
            </a>
        </h3>
        <div class="product-details flex justify-between items-center">
            <p class="price text-lg">S/ {product?.price.toFixed(2)}</p>
            <!-- <div class="view-project">
                <a href={`/products/${product?.id}`} class="bg-gold-1 px-4 py-2 rounded-lg text-[#f8f8f8]">
                    Ver
                </a>
            </div> -->
        </div>
    </div>
</div>