---
import rawProducts from '@/data/products.json';
import FullProductCard from './FullProductCard.astro';
import ProductCard2 from "@/components/cards/ProductCard2.astro"

interface Props {
    category: string;
    limit?: number;
    link: string;
}

const {category, limit, link} = Astro.props;

const products = rawProducts.filter(p => p.category === category).slice(0, limit)
---

<section>
    <h2 class="text-3xl font-bold mb-4">{category}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-8">
        {
            products.map(product => (
                // <FullProductCard product={product} />
                <ProductCard2 
                    id={product.id}
                />
            ))
        }
    </div>
    <div class="flex justify-end mt-4">
        <a href={link} class="text-gold-1 font-bold">Ver más ></a>
    </div>
</section>